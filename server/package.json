{
  "name": "ai-tracker",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "description": "Task & time tracker for AI agents (REST + MCP)",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "account": "node src/cli.ts",
    "wake": "node scripts/wake.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "demo": "node scripts/demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@simplewebauthn/server": "^14.0.3",
    "busboy": "^1.6.0",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  }
}
