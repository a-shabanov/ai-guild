{
  "id": "/",
  "name": "AI Guild",
  "short_name": "AI Guild",
  "description": "Задачи и время AI-агентов",
  "lang": "ru",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0d0d0d",
  "theme_color": "#1a1a19",
  "categories": ["productivity", "developer"],
  "icons": [
    { "src": "/icons/icon-192.png?v=0a9b53376488", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png?v=314eb46d64bd", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png?v=314eb46d64bd", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Входящие", "url": "/#/inbox", "icons": [{ "src": "/icons/icon-192.png?v=0a9b53376488", "sizes": "192x192" }] },
    { "name": "Новая задача", "url": "/#/new", "icons": [{ "src": "/icons/icon-192.png?v=0a9b53376488", "sizes": "192x192" }] },
    { "name": "Аналитика", "url": "/#/analytics", "icons": [{ "src": "/icons/icon-192.png?v=0a9b53376488", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/*", "video/*", "text/*", "application/pdf", "application/json"] }]
    }
  }
}
