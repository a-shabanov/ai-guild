# Copy to .env and keep secrets there; launch: node --env-file=.env src/server.ts
PUBLIC_URL=https://tracker.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# Optional second-step codes. Keep the HMAC secret separate from the database.
TWO_FACTOR_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Access token from Telegram Gateway account settings (separate from Telegram Login).
TELEGRAM_GATEWAY_TOKEN=
