# Copy to .env and keep secrets there; launch: node --env-file=.env src/server.ts
PUBLIC_URL=https://tracker.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# Optional sign-in through your own OpenID Connect provider (corporate SSO). It appears only when
# the first six are set; addresses must be HTTPS. Register <PUBLIC_URL>/api/auth/oidc/callback there.
OIDC_ISSUER=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_LABEL=Acme SSO
# OIDC_SCOPE=openid email profile
# OIDC_ALGORITHMS=RS256,ES256

# Optional second-step codes. Keep the HMAC secret separate from the database.
TWO_FACTOR_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Access token from Telegram Gateway account settings (separate from Telegram Login).
TELEGRAM_GATEWAY_TOKEN=
